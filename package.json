{
  "name": "head-terminal",
  "productName": "Head Terminal",
  "description": "Terminal desktop para AI coding agents",
  "author": "Matheus",
  "license": "UNLICENSED",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development electron-forge start --",
    "build": "npm run typecheck && electron-forge package",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:electron": "vitest run --config tests/electron/vitest.config.mts",
    "smoke:electron": "npm run package && bash scripts/electron-smoke.sh",
    "smoke:electron:existing": "bash scripts/electron-smoke.sh",
    "smoke:electron:win": "npm run package && node scripts/electron-smoke-win.mjs",
    "smoke:electron:win:existing": "node scripts/electron-smoke-win.mjs",
    "e2e": "bash scripts/e2e.sh",
    "package": "cross-env NODE_ENV=production electron-forge package",
    "make": "cross-env NODE_ENV=production electron-forge make",
    "preview:renderer": "vite preview",
    "dev:renderer": "vite",
    "start:dev": "bash scripts/head-terminal-dev.sh",
    "start:prod": "bash scripts/head-terminal-release.sh",
    "install:desktop": "bash scripts/install-desktop-entry.sh",
    "install:desktop:release": "bash scripts/install-desktop-entry.sh --release"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.23.0",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "cross-env": "^7.0.3",
    "electron": "41.6.0",
    "jsdom": "26.1.0",
    "typescript": "~5.8.3",
    "vite": "6.4.3",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "electron@41.6.0": true,
    "electron-winstaller@5.4.4": true,
    "esbuild@0.25.12": true,
    "node-pty@1.1.0": true
  }
}
